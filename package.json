{
  "name": "sub-switcher",
  "displayName": "SubSwitcher",
  "description": "Switch between your own Claude subscriptions in VS Code without re-logging in, while every account shares the same conversation history and memory. Also switches Codex accounts, one CODEX_HOME per account.",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "whiyoung",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "commands": [
      {
        "command": "subSwitcher.switch",
        "title": "SubSwitcher: Switch Account",
        "category": "SubSwitcher"
      },
      {
        "command": "subSwitcher.setup",
        "title": "SubSwitcher: Run Setup",
        "category": "SubSwitcher"
      },
      {
        "command": "subSwitcher.addAccount",
        "title": "SubSwitcher: Add Account Slot",
        "category": "SubSwitcher"
      },
      {
        "command": "subSwitcher.doctor",
        "title": "SubSwitcher: Diagnose",
        "category": "SubSwitcher"
      },
      {
        "command": "subSwitcher.reset",
        "title": "SubSwitcher: Reset (restore defaults)",
        "category": "SubSwitcher"
      },
      {
        "command": "subSwitcher.disableRemoteControlAutostart",
        "title": "SubSwitcher: Disable Remote Control Autostart",
        "category": "SubSwitcher"
      },
      {
        "command": "subSwitcher.switchCodex",
        "title": "SubSwitcher: Switch Codex Account",
        "category": "SubSwitcher"
      },
      {
        "command": "subSwitcher.addCodexAccount",
        "title": "SubSwitcher: Add Codex Account Slot",
        "category": "SubSwitcher"
      }
    ],
    "configuration": {
      "title": "SubSwitcher",
      "properties": {
        "subSwitcher.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the active account in the status bar."
        },
        "subSwitcher.statusBarAlignment": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "default": "right",
          "description": "Which side of the status bar to show the account indicator on."
        },
        "subSwitcher.promptNewConversationAfterSwitch": {
          "type": "boolean",
          "default": true,
          "description": "After switching accounts, offer to open a new Claude Code conversation (running conversations keep their original account)."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "audit:compliance": "node scripts/compliance-audit.mjs",
    "check": "npm run typecheck && npm run audit:compliance && npm run test",
    "package": "npm run check && npm run build -- --production && npx --yes @vscode/vsce package --no-dependencies",
    "vscode:prepublish": "npm run build -- --production",
    "test": "node esbuild.mjs --test && node dist-test/run.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.94.0",
    "esbuild": "0.24.2",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/whi02/sub-switcher.git"
  },
  "author": "whiyoung",
  "bugs": {
    "url": "https://github.com/whi02/sub-switcher/issues"
  },
  "homepage": "https://github.com/whi02/sub-switcher#readme"
}
